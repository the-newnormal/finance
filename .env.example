# Supabase (Project Settings → API). The publishable key is safe in the browser: RLS decides what it can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never expose to the client. Used only to invite, deactivate and reactivate logins (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# This site's own URL, no trailing slash (locally http://localhost:3000). Must match Supabase Auth's Site URL.
NEXT_PUBLIC_SITE_URL=

# Encrypts PayNow / bank details (AES-256-GCM). 32 bytes, base64: `pnpm gen-key`. Server-only.
# Back it up: payout details saved under a lost key can't be read again.
PAYOUT_ENCRYPTION_KEY=

# Claim notification e-mails over SMTP (Gmail: smtp.gmail.com, 465, an app password). Leave
# SMTP_PASSWORD blank locally and none are sent (only an error code is logged).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Server-only.
SMTP_PASSWORD=
MAIL_FROM=

# AI receipt checks: reviewers' pending claims have their receipts read by Claude (Anthropic's API)
# as advice. Server-only; never give it a NEXT_PUBLIC_ prefix. Leave blank to turn the check off.
ANTHROPIC_API_KEY=
